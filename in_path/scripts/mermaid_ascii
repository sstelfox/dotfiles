"""mermaid-ascii: generate ASCII/Unicode diagrams from mermaid code.

A single-file Python port of https://github.com/AlexanderGrooff/mermaid-ascii
(originally written in Go). Supports flowchart/graph, sequence, and
entity-relationship (erDiagram) diagrams.

Usage:
    mermaid_ascii.py -f diagram.mmd
    cat diagram.mmd | mermaid_ascii.py
    mermaid_ascii.py -a -f diagram.mmd     # ASCII-only character set
"""

import argparse
import heapq
import re
import sys
from typing import List

# ---------------------------------------------------------------------------
# Display-width (exact port of github.com/mattn/go-runewidth@v0.0.19,
# EastAsianWidth=false). The tables below are copied verbatim from
# runewidth_table.go / runewidth.go so widths match byte-for-byte.
# ---------------------------------------------------------------------------

